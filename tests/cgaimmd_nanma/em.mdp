integrator          = steep
emtol               = 100
emstep              = 0.005
nsteps              = 200
nstcomm             = 100
comm-mode           = Linear
nstenergy           = 100
nstlog              = 100
constraints         = none
cutoff-scheme       = Verlet
nstlist             = 20
verlet-buffer-tolerance = -1
rlist               = 3.0
pbc                 = xyz
coulombtype         = Cut-off
rcoulomb            = 3.0
vdwtype             = Cut-off
rvdw                = 3.0
DispCorr            = no
tcoupl              = no
pcoupl              = no
gen_vel             = no
